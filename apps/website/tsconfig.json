{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "types": ["node", "@capacitor/core", "vue"],
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "#imports": [".nuxt/imports.d.ts"]
    },
    "baseUrl": "."
  },
  "include": ["./**/*.ts", "./**/*.vue"],
  "exclude": [
    "node_modules",
    "nuxt.config.ts",
    "tests",
    "tests/**",
    "playwright.config.ts",
    "**/*.spec.ts",
    "tests/**/*.ts",
    "tests/**/*.spec.ts",
    "tests/fixtures/**"
  ]
}
